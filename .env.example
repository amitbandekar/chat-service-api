XKIRO_API_KEY=sk-xt-13010123023023102130
XKIRO_BASE_URL=https://api.xkiro.com/v1
MODEL_NAME=qwen/qwen3.8-max:free

# Target WhatsApp number with country code (e.g. 919876543210@c.us for Indian numbers)
TARGET_PHONE_NUMBER=919876543210@c.us

# Inactivity trigger in daytime hours (between 07:00 and 00:00)
INACTIVITY_HOURS_THRESHOLD=8

# ---------------- TIMEZONE (IMPORTANT) ----------------
# The bot must reason in India time. Render runs in UTC, so TZ pins the whole
# Node process and services/timeService.js forces IST for clocks shown to the LLM.
TZ=Asia/Kolkata

# ---------------- PROACTIVE ANTI-SPAM BUDGET (IST) ----------------
# Max unsolicited messages the bot may initiate in one IST day
PROACTIVE_MAX_PER_DAY=3
# Minimum gap between any two proactive messages (nudge/reminder/cricket)
PROACTIVE_MIN_GAP_HOURS=4
# Max inactivity nudges per IST day (registered reminders still respect the cap above)
NUDGE_MAX_PER_DAY=1

# One-time overload reset: set true once, redeploy, then remove the var.
# Staggers overdue scheduled reminders + cooldowns (see db/reset_proactive_state.sql)
# RESET_PROACTIVE_STATE=true

# ---------------- REPLY QUEUE ("no message remains unreplied") ----------------
# Failed replies are queued in Postgres and retried with backoff:
# 1m -> 5m -> 15m -> 30m -> 1h ... until answered. Optional knobs:
# REPLY_MAX_ATTEMPTS=8
# REPLY_RECONCILE_DAYS=7

# Postgres — source of truth for prompt/persona/life-context/chat log.
# Files remain as backup/seed. Bot falls back to files if unset/unreachable.
# Example: postgres://rutuja_app:changeme@localhost:5432/rutuja_bot
DATABASE_URL=postgres://rutuja_app:changeme@localhost:5432/rutuja_bot
